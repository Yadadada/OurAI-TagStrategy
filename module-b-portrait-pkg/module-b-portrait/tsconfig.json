{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "outDir": "dist",
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "declaration": false,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "paths": {
      "@coursework/shared-fixtures": ["../shared-fixtures/src/index.ts"],
      "@coursework/shared-fixtures/questionnaire": ["../shared-fixtures/src/questionnaire.ts"]
    }
  },
  "include": ["src/**/*", "contracts/**/*", "tests/**/*"]
}
